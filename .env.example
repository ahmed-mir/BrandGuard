# Development template only. Django does not load .env files automatically.
# Copy supported keys into your shell or a local ignored .env file.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave unset to use the existing local db.sqlite3 file.
# Production requires a postgresql:// or postgres:// URL and never falls back to SQLite.
# DATABASE_URL=
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=60
# Optional TLS override. Production requires require, verify-ca, or verify-full.
# DB_SSLMODE=require

# PORT is supplied by Render. 10000 is a convenient local Gunicorn default.
PORT=10000

# HSTS remains off until an HTTPS host is verified. Enable with a cautious value later.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# Local private storage is outside MEDIA_URL and is ignored by Git.
PRIVATE_DOCUMENT_ROOT=private_uploads
# Production document imports are disabled unless private S3-compatible storage is configured.
# Set these in Render only when the bucket has Block Public Access and private object policies.
# PRIVATE_DOCUMENT_STORAGE_BACKEND=storages.backends.s3.S3Storage
# PRIVATE_DOCUMENT_BUCKET=
# PRIVATE_DOCUMENT_REGION=
# PRIVATE_DOCUMENT_ENDPOINT_URL=
# Credentials are resolved by boto3. Prefer a scoped workload identity when available.
# Otherwise provide AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY through the host's secret store.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Local demo passwords; never reuse production credentials. Unset values are generated locally.
# BRANDGUARD_DEMO_CREATOR_PASSWORD=
# BRANDGUARD_DEMO_BRAND_MANAGER_PASSWORD=
# BRANDGUARD_DEMO_REVIEWER_PASSWORD=
# BRANDGUARD_DEMO_ADMIN_PASSWORD=
# BRANDGUARD_DEMO_PASSWORD=

# Production bootstrap has a separate CLI confirmation and this second explicit opt-in.
# Never leave enabled for normal deployments.
# BRANDGUARD_ALLOW_PRODUCTION_DEMO_BOOTSTRAP=YES

# Brand document ingestion limits; maxima are enforced by settings.
BRAND_DOCUMENT_MAX_UPLOAD_BYTES=5242880
BRAND_DOCUMENT_MAX_PDF_PAGES=10
BRAND_DOCUMENT_MAX_EXTRACTED_CHARS=80000

# Optional advisory analysis. Real provider calls are disabled by default; a key alone never enables them.
BRANDGUARD_AI_ENABLED=false
# Repository-controlled simulated results for demonstrations; no provider is contacted.
BRANDGUARD_AI_DEMO_MODE=false
# Needed only for real provider mode; never needed by Demo AI mode.
# OPENAI_API_KEY=
BRANDGUARD_AI_MODEL=gpt-5.4-mini
# Synchronous provider timeout is capped at 20 seconds (below the small-service Gunicorn timeout).
BRANDGUARD_AI_TIMEOUT_SECONDS=15
BRANDGUARD_AI_MAX_OUTPUT_TOKENS=1400
BRANDGUARD_AI_MAX_FINDINGS=12
BRANDGUARD_AI_MAX_CONTEXT_CHARS=10000

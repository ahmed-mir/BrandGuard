# Copy values into your shell environment before starting the server.
# This file is documentation only; .env files are not loaded automatically.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for SQLite. PostgreSQL example:
# DATABASE_URL=postgresql://USER@localhost:5432/DATABASE
# Per-role demo passwords may be set via BRANDGUARD_DEMO_<ROLE>_PASSWORD.
# Leave these unset to have seed_demo generate one-time local credentials.
BRANDGUARD_DEMO_PASSWORD=
BRANDGUARD_DEMO_CREATOR_PASSWORD=
BRANDGUARD_DEMO_BRAND_MANAGER_PASSWORD=
BRANDGUARD_DEMO_REVIEWER_PASSWORD=
BRANDGUARD_DEMO_ADMIN_PASSWORD=
# Brand document ingestion defaults: 5 MiB, 10 PDF pages, 80,000 extracted characters.
BRAND_DOCUMENT_MAX_UPLOAD_BYTES=5242880
BRAND_DOCUMENT_MAX_PDF_PAGES=10
BRAND_DOCUMENT_MAX_EXTRACTED_CHARS=80000
# Local imports stay outside MEDIA_URL/static serving. Use a private backend in deployments.
PRIVATE_DOCUMENT_ROOT=private_uploads
# PRIVATE_DOCUMENT_STORAGE_BACKEND=your.private.storage.Backend
# PRIVATE_DOCUMENT_STORAGE_OPTIONS={}
